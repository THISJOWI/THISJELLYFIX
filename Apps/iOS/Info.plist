<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Background Modes: "Audio, AirPlay, and Picture in Picture".
	     Lets AVPlayer keep the floating PiP window alive when the app
	     backgrounds, and lets VLC keep streaming audio as fallback when
	     HLS/PiP is unavailable. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- Local network: Radarr/Sonarr answer on the user's LAN. Without this
	     key iOS 14+ denies those connections and shows NO dialog at all,
	     so the app just reports "unreachable". -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>ThisJellyfix se conecta a Radarr y Sonarr en tu red local para buscar y descargar películas y series.</string>

	<!-- Bonjour services: required in iOS 14+ for local network discovery
	     and for triggering the Local Network permission dialog reliably. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
		<string>_bonjour._tcp</string>
		<string>_lnp._tcp.</string>
		<!-- AirPlay receiver discovery (AVRoutePickerView / external playback). -->
		<string>_airplay._tcp</string>
	</array>

	<!-- Radarr/Sonarr on http://192.168.x.x:7878 speak plain HTTP: ATS
	     blocks it unless local networking is explicitly allowed. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Handoff: activity types this app can both publish and receive.
	     Without this key the system silently drops incoming Handoff requests. -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>com.thisjellyfix.activity.browsing</string>
		<string>com.thisjellyfix.activity.detail</string>
		<string>com.thisjellyfix.activity.playing</string>
	</array>
</dict>
</plist>
