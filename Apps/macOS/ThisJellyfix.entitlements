<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Group: shared UserDefaults + Keychain across all targets (iOS, macOS, tvOS, visionOS) -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.thisjellyfix</string>
	</array>

	<!-- Keychain Sharing: lets iCloud Keychain sync credentials across devices -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.thisjellyfix</string>
	</array>

	<!-- macOS sandboxing requirements -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
